{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lukart.local/schemas/legal_source_profile_v1.schema.json",
  "title": "LUKART LegalSourceProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_id",
    "jurisdiction",
    "institution",
    "source_classes",
    "authority_capabilities",
    "privacy_class",
    "access_mode",
    "canonical_base_uri",
    "allowed_hosts",
    "temporal_coverage",
    "fallback_policy",
    "fallback_source_ids"
  ],
  "properties": {
    "schema": {
      "const": "lukart.legal-authority.source-profile.v1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "institution": {
      "type": "string",
      "minLength": 1
    },
    "source_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PRIMARY_PUBLICATION",
          "OFFICIAL_CONSOLIDATED",
          "OFFICIAL_JURISPRUDENCE",
          "OFFICIAL_OPEN_DATA",
          "OFFICIAL_OPERATIONAL",
          "DERIVED_OPEN_SOURCE"
        ]
      }
    },
    "authority_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PUBLICATION_IDENTITY",
          "NORM_TEXT",
          "TEMPORAL_STATUS",
          "JUDGMENT_FULL_TEXT",
          "CITATION_METADATA",
          "OPERATIONAL_STATE",
          "DISCOVERY"
        ]
      }
    },
    "privacy_class": {
      "enum": ["PUBLIC", "CASE_SENSITIVE", "PRIVATE_CASE_DATA"]
    },
    "access_mode": {
      "enum": ["WEB", "API", "WEB_AND_API"]
    },
    "canonical_base_uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "allowed_hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
      }
    },
    "temporal_coverage": {
      "enum": ["EXACT", "PARTIAL", "NONE", "UNKNOWN"]
    },
    "fallback_policy": {
      "enum": ["NONE", "OFFICIAL_ONLY", "DISCOVERY_ONLY"]
    },
    "fallback_source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fallback_policy": {"const": "NONE"}
        }
      },
      "then": {
        "properties": {
          "fallback_source_ids": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "fallback_source_ids": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_classes": {
            "contains": {"const": "DERIVED_OPEN_SOURCE"}
          }
        }
      },
      "then": {
        "properties": {
          "source_classes": {"maxItems": 1}
        }
      }
    }
  ]
}
